            {
              "id": "variables-basics-quiz",
              "order": 2,
              "title": "Проверь себя: переменные",
              "kind": "quiz",
              "estimatedTimeMinutes": 5,
              "tasks": [
                {
                  "id": "variables-quiz-basic",
                  "type": "quiz",
                  "selection": "multiple",
                  "question": "Выберите корректные объявления переменных в C#.",
                  "scoring": {
                    "points": 3,
                    "partial": true
                  },
                  "options": [
                    {
                      "id": "option-1",
                      "text": "int count = 10;",
                      "isCorrect": true,
                      "feedback": "Корректное объявление целочисленной переменной."
                    },
                    {
                      "id": "option-2",
                      "text": "var name;",
                      "isCorrect": false,
                      "feedback": "var требует обязательной инициализации."
                    },
                    {
                      "id": "option-3",
                      "text": "string title = \"Intro\";",
                      "isCorrect": true,
                      "feedback": "Строка инициализирована корректно."
                    },
                    {
                      "id": "option-4",
                      "text": "decimal price = \"9.99\";",
                      "isCorrect": false,
                      "feedback": "Строку нельзя присвоить decimal без явного преобразования."
                    }
                  ],
                  "solution": {
                    "correctOptionIds": [
                      "option-1",
                      "option-3"
                    ],
                    "explanation": "var требует инициализации, а decimal не принимает строку без преобразования."
                  },
                  "hints": [
                    "Помните про вывод типа при использовании var.",
                    "Сравните типы выражений с типами переменных."
                  ]
                }
              ]
            },
            {
              "id": "variables-operations",
              "order": 3,
              "title": "Арифметика и приведения",
