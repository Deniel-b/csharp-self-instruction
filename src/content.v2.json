            },
            {
              "id": "variables-operations-code",
              "order": 4,
              "title": "Практика: среднее арифметическое",
              "kind": "code",
              "estimatedTimeMinutes": 10,
              "tasks": [
                {
                  "id": "variables-code-average",
                  "type": "code",
                  "title": "Среднее арифметическое",
                  "prompt": "Считайте три целых числа и выведите их среднее арифметическое с точностью до двух знаков после запятой.",
                  "starterCode": "using System;\nusing System.Globalization;\n\npublic static class Solution\n{\n    public static void Solve()\n    {\n        // Подсказка: используйте decimal или double и ToString(\"F2\")\n    }\n}\n",
                  "entryPoint": {
                    "class": "Solution",
                    "method": "Solve",
                    "signature": "public static void Solve()"
                  },
                  "constraints": {
                    "timeLimitMs": 2000,
                    "memoryLimitMb": 128
                  },
                  "scoring": {
                    "points": 6,
                    "partial": true
                  },
                  "tests": [
                    {
                      "id": "sample-1",
                      "visibility": "public",
                      "input": "1 2 3\n",
                      "expectedOutput": "2.00\n",
                      "explanation": "1 + 2 + 3 = 6, 6 / 3 = 2.00"
                    },
                    {
                      "id": "sample-2",
                      "visibility": "public",
                      "input": "5 10 15\n",
                      "expectedOutput": "10.00\n"
                    },
                    {
                      "id": "hidden-1",
                      "visibility": "hidden",
                      "input": "-10 0 10\n",
                      "expectedOutput": "0.00\n"
                    },
                    {
                      "id": "hidden-2",
                      "visibility": "hidden",
                      "input": "100 200 101\n",
                      "expectedOutput": "133.67\n"
                    }
                  ],
                  "hints": [
                    "Сумма трёх целых чисел может быть нецелой при делении.",
                    "Используйте CultureInfo.InvariantCulture для вывода."
                  ]
                }
              ]
            },
            {
              "id": "variables-summary",
