              "resources": [
                {
                  "type": "externalLink",
                  "title": "Документация: Console.WriteLine",
                  "url": "https://learn.microsoft.com/dotnet/api/system.console.writeline"
                }
              ]
            },
            {
              "id": "intro-hello-world-quiz",
              "order": 3,
              "title": "Проверь себя: Hello World",
              "kind": "quiz",
              "estimatedTimeMinutes": 5,
              "tasks": [
                {
                  "id": "intro-quiz-hello-world",
                  "type": "quiz",
                  "selection": "single",
                  "question": "Какой метод выводит строку в консоль и переносит курсор на новую строку?",
                  "scoring": {
                    "points": 2,
                    "partial": false
                  },
                  "options": [
                    {
                      "id": "option-console-write-line",
                      "text": "Console.WriteLine();",
                      "isCorrect": true,
                      "feedback": "Именно Console.WriteLine выводит строку и завершает её переводом строки."
                    },
                    {
                      "id": "option-system-print",
                      "text": "System.Print();",
                      "isCorrect": false,
                      "feedback": "Такого метода в .NET нет."
                    },
                    {
                      "id": "option-console-log",
                      "text": "Console.Log();",
                      "isCorrect": false,
                      "feedback": "Console.Log — метод из JavaScript, но не из C#."
                    },
                    {
                      "id": "option-debug-write-line",
                      "text": "Debug.WriteLine();",
                      "isCorrect": false,
                      "feedback": "Debug.WriteLine выводит в окно отладчика, а не в стандартную консоль."
                    }
                  ],
                  "hints": [
                    "Вспомните класс Console и его методы.",
                    "Метод должен завершаться переводом строки."
                  ],
                  "solution": {
                    "correctOptionIds": [
                      "option-console-write-line"
                    ],
                    "explanation": "Console.WriteLine выводит строку и завершает её символом новой строки."
                  }
                }
              ]
            },
            {
              "id": "intro-hello-world-code",
              "order": 4,
              "title": "Практика: Hello World",
              "kind": "code",
              "estimatedTimeMinutes": 10,
              "tasks": [
                {
                  "id": "intro-code-hello-world",
                  "type": "code",
                  "title": "Приветствие пользователя",
                  "prompt": "Считайте из консоли имя и выведите \"Hello, <name>!\". Имя может содержать пробелы.",
                  "starterCode": "using System;\n\npublic static class Solution\n{\n    public static void Solve()\n    {\n        // TODO: считайте имя пользователя и выведите приветствие\n    }\n}\n",
                  "entryPoint": {
                    "class": "Solution",
                    "method": "Solve",
                    "signature": "public static void Solve()"
                  },
                  "constraints": {
                    "timeLimitMs": 2000,
                    "memoryLimitMb": 128,
                    "disallow": [
                      "Environment.Exit",
                      "Process.Start"
                    ]
                  },
                  "scoring": {
                    "points": 5,
                    "partial": true
                  },
                  "tests": [
                    {
                      "id": "sample-1",
                      "visibility": "public",
                      "input": "Alice\n",
                      "expectedOutput": "Hello, Alice!\n",
                      "explanation": "Пользователь вводит имя Alice."
                    },
                    {
                      "id": "sample-2",
                      "visibility": "public",
                      "input": "Bob\n",
                      "expectedOutput": "Hello, Bob!\n"
                    },
                    {
                      "id": "hidden-1",
                      "visibility": "hidden",
                      "input": "C# Learner\n",
                      "expectedOutput": "Hello, C# Learner!\n"
                    }
                  ],
                  "hints": [
                    "Используйте Console.ReadLine и интерполяцию строк.",
                    "Не забывайте про символ новой строки в ответе."
                  ]
                }
              ]
            }
          ],
          "summary": "История появления C#, экосистема .NET и установка инструментов."
        }
      ]
    },
